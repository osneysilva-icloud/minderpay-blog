# ============================================================
# VARIÁVEIS DE AMBIENTE - MODELO PARA CONFIGURAÇÃO (VERCEL / LOCAL)
# ============================================================
# Obtenha estas informações no seu painel do Supabase:
# Supabase Dashboard -> Project Settings -> API
# ============================================================

# 1. Dados Públicos do Supabase (URL do Projeto e Anon Key)
VITE_SUPABASE_PROJECT_ID="coloque_aqui_o_id_do_projeto_supabase"
VITE_SUPABASE_URL="https://coloque_aqui_o_id_do_projeto_supabase.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="coloque_aqui_a_sua_anon_public_key"

# 2. Dados do Servidor (Necessários para rotas de servidor e upload)
SUPABASE_PROJECT_ID="coloque_aqui_o_id_do_projeto_supabase"
SUPABASE_URL="https://coloque_aqui_o_id_do_projeto_supabase.supabase.co"
SUPABASE_PUBLISHABLE_KEY="coloque_aqui_a_sua_anon_public_key"
SUPABASE_SERVICE_ROLE_KEY="coloque_aqui_a_sua_service_role_secret_key"

# 3. URL do seu site em produção
VITE_SITE_URL="https://seusite.com"

# 4. (Opcional) Credenciais personalizadas para o primeiro Administrador
ADMIN_EMAIL="admin@seusite.com"
ADMIN_PASSWORD="SuaSenhaSegura123!"
ADMIN_NAME="Administrador"
